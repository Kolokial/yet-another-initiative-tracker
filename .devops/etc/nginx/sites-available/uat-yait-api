server {
    server_name uat-api-yait.airdnd.co.uk;

    location / {
        proxy_pass http://localhost:6000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Add CORS headers in the response
        proxy_set_header Access-Control-Allow-Origin "https://uat-yait.airdnd.co.uk";
        proxy_set_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
        proxy_set_header Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, X-SignalR-User-Agent";
        proxy_set_header Access-Control-Allow-Credentials "true";
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/uat-api-yait.airdnd.co.uk/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/uat-api-yait.airdnd.co.uk/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = uat-api-yait.airdnd.co.uk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name uat-api-yait.airdnd.co.uk;
    listen 80;
    return 404; # managed by Certbot


}