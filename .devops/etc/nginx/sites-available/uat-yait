server {

        root /var/www/uat-yait/front-end;
        index index.html index.htm index.nginx-debian.html;

        server_name uat-yait.airdnd.co.uk;

        location / {
                try_files $uri $uri/ /index.html;
        }

    location /api/ {
        proxy_pass http://localhost:9090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }



    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/uat-api-yait.airdnd.co.uk/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/uat-api-yait.airdnd.co.uk/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = uat-yait.airdnd.co.uk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot



        server_name uat-yait.airdnd.co.uk;
    listen 80;
    return 404; # managed by Certbot


}